# ─── Groq AI ────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_TEXT_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=qwen/qwen3.6-27b
GROQ_RESEARCH_MODEL=groq/compound

# ─── Optional real avatar image generation ──────────────────────────────────
# Empty keeps the privacy-friendly DiceBear fallback.
AVATAR_IMAGE_PROVIDER=
OPENAI_API_KEY=
OPENAI_IMAGES_API_URL=https://api.openai.com/v1/images/generations
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=medium
DICEBEAR_API_URL=https://api.dicebear.com/9.x

# ─── Google / Firebase ───────────────────────────────────────────────────────
# Firebase Auth REST API anahtarıdır; Groq ile ilgili değildir.
GOOGLE_API_KEY=your_firebase_web_api_key_here
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
# Opsiyonel: Premium Google Cloud TTS (Metin-to-Ses) için Google Cloud JSON servis hesabı dosya yolu
GOOGLE_APPLICATION_CREDENTIALS=

# ─── Google OAuth ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_USERINFO_URL=https://www.googleapis.com/oauth2/v2/userinfo
GOOGLE_CALENDAR_EVENTS_URL=https://www.googleapis.com/calendar/v3/calendars/primary/events

# ─── External APIs ───────────────────────────────────────────────────────────
YOUTUBE_DATA_API_KEY=your_youtube_api_key_here
YOUTUBE_API_URL=https://www.googleapis.com/youtube/v3/search
UDEMY_CLIENT_ID=your_udemy_client_id
UDEMY_CLIENT_SECRET=your_udemy_client_secret
UDEMY_API_URL=https://www.udemy.com/api-2.0/courses/
UDEMY_WEB_URL=https://www.udemy.com
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_API_URL=https://api.github.com
GITHUB_TOKEN_URL=https://github.com/login/oauth/access_token
SERPAPI_API_KEY=
GOOGLE_CUSTOM_SEARCH_API_KEY=
GOOGLE_CUSTOM_SEARCH_CX=

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change_this_to_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ─── App ─────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
ALLOW_ANONYMOUS_DEV=false
ALTERLIFE_DB_FILE=./alterlife_db.json
